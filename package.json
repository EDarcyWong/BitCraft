{
  "name": "bitcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vue-tsc --noEmit",
    "format": "prettier --write src tests index.html package.json tsconfig.json vite.config.ts .github/workflows/ci.yml"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
